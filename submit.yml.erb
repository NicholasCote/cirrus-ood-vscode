<%-
  utility_img = "docker.io/ohiosupercomputer/ood-k8s-utils:latest"
  user = OodSupport::User.new

  # Everything below that touches form input is validated here, before it
  # reaches any YAML.
  #
  # This app renders submit.yml.erb; ood_core then parses the result and renders
  # its own pod.yml.erb from it, and that template interpolates values either
  # bare (the image field) or inside plain double quotes (env values). We do not
  # control that template, so a form value containing ": ", a double quote, "#",
  # or a newline can restructure the generated Pod manifest. Rather than try to
  # out-escape a template in another gem, reject anything that isn't the shape
  # we expect at the door.

  image_ref = custom_image.to_s.strip
  unless image_ref.match?(%r{\A[A-Za-z0-9][A-Za-z0-9._\-/:@]{0,254}\z})
    raise "Invalid container image reference: #{image_ref.inspect}. " \
          "Expected something like registry.example.com/namespace/image:tag " \
          "(letters, digits, '.', '_', '-', '/', ':', '@' only; no spaces or quotes)."
  end

  # Blank means "open my home directory". launch.sh re-checks that the path is
  # actually a directory once it is inside the container and falls back to $HOME
  # if it is not -- the OnDemand host and the pod do not necessarily agree about
  # what exists, so the check that matters has to happen there.
  workdir = working_dir.to_s.strip
  workdir = user.home if workdir.empty?
  unless workdir.match?(%r{\A/[A-Za-z0-9 ._\-/]{0,1023}\z})
    raise "Invalid working directory: #{workdir.inspect}. " \
          "Expected an absolute path built from letters, digits, spaces, " \
          "'.', '_', '-', and '/'."
  end

  # GECOS is the one field here that comes from the site's user database rather
  # than the form, and it is free text. A colon in it would shift every field
  # after it in the passwd line below; a newline would add a whole entry.
  gecos = user.gecos.to_s.gsub(/[:\r\n]/, " ").strip
-%>
---
script:
  wall_time: "<%= wall_time.to_i * 3600 %>"
  native:
    container:
      name: "code-server"
      image: "<%= image_ref %>"
      # Launched through /ood/launch.sh rather than by naming code-server
      # directly, for two reasons:
      #
      #   1. The session password does not exist yet at this point. It is
      #      generated by an init container and has to be read at runtime --
      #      see the configmap and init_containers sections below.
      #   2. code-server's install location varies by image (the convenience
      #      installer puts it in /usr/bin, tarball installs land in
      #      /usr/lib or /opt), and naming the wrong one fails with a bare
      #      "executable file not found" that says nothing about what was
      #      missing.
      #
      # Every token is space-free on purpose: ood_core runs this through
      # Shellwords.split into the pod's `command` array, so this is not a shell
      # and a quoted `sh -c '...'` payload would not survive the trip.
      # Invoking via /bin/sh also avoids depending on the configmap file being
      # executable, which projected volumes do not guarantee.
      command: "/bin/sh /ood/launch.sh"
      restart_policy: "OnFailure"
      # Start in the user's home rather than wherever the image's WORKDIR
      # points, which for Jupyter-derived images is a throwaway /home/jovyan
      # that vanishes with the pod.
      working_dir: "<%= user.home %>"
      env:
        HOME: "<%= user.home %>"
        USER: "<%= user.name %>"
        # VS Code's integrated terminal launches $SHELL. Jupyter-derived images
        # have bash; the user's real login shell (often tcsh here) usually is
        # not present, so do not copy it from their passwd entry.
        SHELL: "/bin/bash"
        CODE_SERVER_WORKDIR: "<%= workdir %>"
      port: 8080
      cpu: "<%= cpu %>"
      memory: "<%= memory %>Gi"
      # ood_core's default startup probe allows 2s + 5 x 5s = 27s for the port
      # to open, and that is not enough here: launch.sh waits for the init
      # container's password to land in the configmap before it binds anything,
      # and the pod would be killed mid-wait. Allow five minutes.
      startup_probe:
        initial_delay_seconds: 5
        failure_threshold: 60
        period_seconds: 5
    mounts:
      - type: nfs
        name: home
        host: "gladenfs.hpc.ucar.edu"
        path: "/gpfs/u/home/<%= user.name %>"
        destination_path: "<%= user.home %>"
    configmap:
      files:
        # One mount_path for the whole configmap. ood_core emits a volumeMount
        # per file that declares one, and each of those mounts the entire
        # configmap volume -- so two files naming the same mount_path produce
        # duplicate mountPaths and the API server rejects the pod outright:
        #   spec.containers[0].volumeMounts[1].mountPath: "/ood": must be unique
        # Files below with no mount_path are still projected into /ood; they
        # just do not add a second mount of the same volume.
        - filename: "launch.sh"
          mount_path: "/ood"
          data: |
            #!/bin/sh
            # Deliberately plain /bin/sh -- an image may not ship bash.
            set -u

            CSENV=/ood/csenv
            PORT=8080

            # --- 1. Wait for the session password ------------------------------
            #
            # The password is generated by the init-secret container, stored in a
            # k8s Secret, and copied into this configmap by add-passwd-to-cfg.
            # OnDemand reads the same Secret to build the Connect button, so both
            # ends agree without the password ever being rendered into an app
            # template.
            #
            # The wait is what makes that race-free. Volumes are mounted before
            # init containers run, so this file is already projected -- empty --
            # by the time the init container edits the underlying ConfigMap.
            # Kubelet watches ConfigMaps and re-projects within a second or two,
            # but "usually fast enough" is not a guarantee, and losing that race
            # silently would produce a session whose Connect button is rejected
            # with no clue why.
            i=0
            while [ "$i" -lt 120 ]; do
              if [ -f "$CSENV" ] && grep -q '^password=' "$CSENV"; then
                break
              fi
              i=$((i + 1))
              sleep 1
            done

            PASSWORD="$(sed -n 's/^password=//p' "$CSENV" 2>/dev/null | head -n 1)"
            if [ -z "$PASSWORD" ]; then
              echo "launch.sh: gave up after ${i}s waiting for the session password." >&2
              echo "  Expected a 'password=' line in $CSENV, written by the" >&2
              echo "  add-passwd-to-cfg init container. Current contents:" >&2
              cat "$CSENV" >&2 2>/dev/null
              exit 1
            fi
            # code-server reads $PASSWORD for --auth=password. This takes
            # precedence over any ~/.config/code-server/config.yaml that a
            # previous session left in the user's home -- which matters, because
            # code-server writes that file itself on first run with a random
            # password of its own.
            export PASSWORD

            # --- 2. Find code-server -------------------------------------------
            #
            # /usr/bin is where the convenience installer at code-server.dev puts
            # the symlink, and is what the Cirrus JupyterHub images have. The
            # rest cover tarball and standalone installs.
            for c in /usr/bin/code-server \
                     /usr/local/bin/code-server \
                     /usr/lib/code-server/bin/code-server \
                     /opt/code-server/bin/code-server \
                     "$HOME/.local/bin/code-server"; do
              if [ -x "$c" ]; then
                CS="$c"
                break
              fi
            done
            # Last resort: whatever is on PATH. Covers layouts we have not seen.
            [ -n "${CS:-}" ] || CS="$(command -v code-server 2>/dev/null)"

            if [ -z "${CS:-}" ]; then
              echo "launch.sh: no code-server executable in this image." >&2
              echo "  Looked in: /usr/bin, /usr/local/bin, /usr/lib/code-server/bin," >&2
              echo "  /opt/code-server/bin, \$HOME/.local/bin, and \$PATH." >&2
              echo "  PATH=$PATH" >&2
              echo "  Most Jupyter images do not include code-server; it is a" >&2
              echo "  separate install." >&2
              exit 127
            fi

            # --- 3. Working directory ------------------------------------------
            WORKDIR="${CODE_SERVER_WORKDIR:-$HOME}"
            if [ ! -d "$WORKDIR" ]; then
              echo "launch.sh: '$WORKDIR' is not a directory in this session;" >&2
              echo "  opening $HOME instead. Only your home directory is mounted." >&2
              WORKDIR="$HOME"
            fi
            cd "$WORKDIR" || cd "$HOME" || exit 1

            # --- 4. Persistent state -------------------------------------------
            #
            # On the NFS home on purpose: installed extensions, settings, and
            # window layout then survive the pod, which is the whole point of a
            # session you relaunch every day.
            #
            # Checked rather than assumed. If this directory cannot be created,
            # code-server does not degrade gracefully -- it throws repeated
            # uncaught EACCES exceptions from a background process and the
            # session half-works in a way that is genuinely hard to read from
            # the logs. Falling back to container-local storage keeps the editor
            # usable (and the terminal available to debug with), but it is a
            # real loss of persistence, so say so unmistakably.
            DATA_DIR="$HOME/.local/share/code-server"
            if ! mkdir -p "$DATA_DIR/extensions" 2>/dev/null; then
              echo "launch.sh: WARNING cannot create $DATA_DIR" >&2
              echo "  Your home directory is not writable in this session. That usually" >&2
              echo "  means the NFS mount failed or the pod is running as the wrong UID." >&2
              echo "  Falling back to container-local storage: extensions, settings, and" >&2
              echo "  anything you save outside your home will be LOST when this session" >&2
              echo "  ends." >&2
              DATA_DIR="/tmp/code-server"
              mkdir -p "$DATA_DIR/extensions" || exit 1
              # --user-data-dir alone is not enough to get off the unwritable
              # home. code-server resolves its own log directory through XDG
              # ($XDG_DATA_HOME/code-server/coder-logs), independently of that
              # flag, and keeps retrying the mkdir from a background process --
              # so without this the fallback still spews uncaught EACCES.
              export XDG_DATA_HOME="/tmp/code-server/xdg-data"
              export XDG_CONFIG_HOME="/tmp/code-server/xdg-config"
              export XDG_CACHE_HOME="/tmp/code-server/xdg-cache"
              mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" || exit 1
            fi

            # Say what was chosen. When a session misbehaves the first question
            # is which binary it actually ran, and kubectl logs should answer it
            # without anyone having to exec into the pod.
            echo "launch.sh: code-server=${CS} workdir=${WORKDIR} data=${DATA_DIR}"

            exec "$CS" \
              --auth password \
              --bind-addr "0.0.0.0:${PORT}" \
              --user-data-dir "$DATA_DIR" \
              --extensions-dir "$DATA_DIR/extensions" \
              --disable-telemetry \
              --disable-update-check \
              --ignore-last-opened \
              --log debug \
              "$WORKDIR"
        # Seeded with a comment so the key exists in the ConfigMap for
        # add_line_to_configmap to read back and append to. launch.sh greps for
        # '^password=', so this line never matches.
        - filename: "csenv"
          data: |
            # session password is appended here by the add-passwd-to-cfg init container
        # Give the UID we run as a name.
        #
        # The pod's securityContext is runAsUser: <the user's real UID>, but the
        # image's /etc/passwd only knows the UID it was built with (1000/jovyan
        # for Jupyter-derived images). Every getpwuid() lookup then fails, which
        # surfaces as an "I have no name!" prompt in every VS Code terminal and,
        # less visibly, as git and ssh tripping over a missing home and username.
        #
        # sub_path is what makes this safe: without it the configmap volume would
        # mount over all of /etc and take the image's resolv.conf, ssl certs, and
        # everything else with it. With it, k8s projects this single key over the
        # single file.
        - filename: "passwd"
          data: |
            root:x:0:0:root:/root:/bin/bash
            <%= user.name %>:x:<%= user.uid %>:<%= user.group.id %>:<%= gecos %>:<%= user.home %>:/bin/bash
            nobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin
          mount_path: "/etc/passwd"
          sub_path: "passwd"
        # Same treatment for the primary group, so `id` and `ls -l` render a
        # group name instead of a bare number. Supplemental groups stay numeric;
        # naming them is not worth regenerating this file for.
        - filename: "group"
          data: |
            root:x:0:
            <%= user.group.name %>:x:<%= user.group.id %>:<%= user.name %>
            nogroup:x:65534:
          mount_path: "/etc/group"
          sub_path: "group"
    init_containers:
      # Generate a random password and store it in <pod>-secret. OnDemand's
      # kubernetes adapter reads that Secret back and exposes every key in it to
      # view.html.erb, which is where the `password` local there comes from.
      - name: "init-secret"
        image: "<%= utility_img %>"
        command:
          - "/bin/save_passwd_as_secret"
      # Copy it into the configmap so the container itself can read it. The
      # Secret is not mounted into the pod, and the main container has no
      # kubectl or RBAC to fetch it.
      #
      # No init container computes a base URL here, unlike the Jupyter app: this
      # session is proxied through /rnode/, which strips its own prefix before
      # forwarding, and code-server emits relative roots. Nothing in the pod
      # needs to know the node name or NodePort it was assigned.
      # No double quotes in the command below, and that is load-bearing rather
      # than a style choice.
      #
      # ood_core re-emits every element of this array into its own pod.yml.erb
      # as `- "<the element>"`. A double quote inside the element therefore
      # closes that YAML string early and the whole manifest fails to parse:
      #   error converting YAML to JSON: did not find expected key
      # This is the same hazard the Jupyter app's `Q=$(printf '\\047')` dance
      # exists to work around -- it builds a single quote at runtime precisely
      # so the literal never appears here.
      #
      # Nothing needs quoting in the first place: create_passwd builds the
      # password from [a-zA-Z0-9] only, so it cannot contain a space or a shell
      # metacharacter, and $PASSWORD expands to exactly one word. If it were
      # ever empty the line still lands as `password=`, which launch.sh reports
      # as a missing password rather than silently accepting.
      - name: "add-passwd-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "source /bin/passwd_from_secret; /bin/add_line_to_configmap password=$PASSWORD csenv"
