<%-
  utility_img = "docker.io/ohiosupercomputer/ood-k8s-utils:latest"
  user = OodSupport::User.new

  # Two separate culls. See the "Idle culling" section of the README.
  connected_idle_timeout = 28800  # idle user time with a connected browser
  disconnect_timeout     = 14400  # idle time once the browser session is disconnected
  idle_check_interval    = 300    # how often the culler looks; NOT a timeout

  # CPU used by the whole pod, per check interval, that counts as "the user is
  # doing something". Measured idle baseline for this image is ~200ms per 5min
  # (worst observed minute 120ms), so 2000ms is roughly 3x headroom.
  busy_cpu_ms = 2000

  max_session_hours = 12

  # Our own image (containers/code-server/Dockerfile): upstream code-server
  # plus the toolchain users cannot install without root -- compilers, clangd,
  # Miniforge at /opt/conda, and buildctl.
  #
  # This line is REWRITTEN BY CI. .github/workflows/build-code-server.yml
  # builds the image, pushes it, and commits the new tag back here -- so edit
  # the Dockerfile and let the workflow bump this, rather than hand-editing.
  editor_img = "hub.k8s.ucar.edu/cirrus-ood/code-server:4.131.0-20260916"

  workdir = working_dir.to_s.strip
  workdir = user.home if workdir.empty?
  unless workdir.match?(%r{\A/[A-Za-z0-9 ._\-/]{0,1023}\z})
    raise "Invalid working directory: #{workdir.inspect}. " \
          "Expected an absolute path built from letters, digits, spaces, " \
          "'.', '_', '-', and '/'."
  end

  gecos = user.gecos.to_s.gsub(/[:\r\n]/, " ").strip

  # ~/.kube/config is OnDemand's own service-account kubeconfig, used by
  # OnDemand's server-side polling to report this session's status -- not
  # something a user is meant to edit. The pod runs as the real user (see
  # "Running as the real user" in the README), so ordinary file permissions
  # cannot stop the user from overwriting or deleting their own file. Instead
  # this snapshots whatever is there at submit time and mounts it back
  # read-only over the same path, the same technique already used for
  # /etc/passwd and /etc/group below. A ConfigMap volume is immutable from
  # inside the pod at the kubelet level, not just by permission bits, and
  # this only shadows that one file -- the rest of ~/.kube/ (a user's own
  # personal kubeconfig, cache, etc.) is untouched.
  #
  # Snapshotting rather than hand-writing the content means this does not
  # need to know or guess OnDemand's namespace/username naming convention,
  # and self-corrects if that convention ever changes. Never let a missing
  # or unreadable file break submission -- a user with no kubeconfig yet
  # just gets no protection to apply.
  kube_config_lines = begin
                         File.readlines(File.join(user.home, ".kube", "config"), chomp: true)
                       rescue StandardError
                         []
                       end
-%>
---
script:
  wall_time: "<%= max_session_hours * 3600 %>"
<%- if gpus.to_i > 0 -%>
  gpus_per_node: <%= gpus.to_i %>
<%- end -%>
  native:
    container:
      name: "code-server"
      image: "<%= editor_img %>"
      command: "/bin/sh /ood/launch.sh"
      restart_policy: "OnFailure"
      working_dir: "<%= user.home %>"
      env:
        HOME: "<%= user.home %>"
        USER: "<%= user.name %>"
        SHELL: "/bin/bash"
        CODE_SERVER_WORKDIR: "<%= workdir %>"
        # buildctl ships in the image; the endpoint is site topology and stays
        # here so the image itself carries none.
        BUILDKIT_HOST: "tcp://buildkitd.arc-systems.svc:1234"
      port: 8080
      cpu: "<%= cpu %>"
      memory: "<%= memory %>Gi"
      startup_probe:
        initial_delay_seconds: 5
        failure_threshold: 60
        period_seconds: 5
    mounts:
      - type: nfs
        name: home
        host: "gladenfs.hpc.ucar.edu"
        path: "/gpfs/u/home/<%= user.name %>"
        destination_path: "<%= user.home %>"
      - type: nfs
        name: campaign
        host: "gladedm1.ucar.edu"
        path: "/gpfs/csfs1"
        destination_path: /glade/campaign
      - type: nfs
        name: gdex
        host: "gladedm1.ucar.edu"
        path: "/gpfs/csfs1/collections/gdex"
        destination_path: /gdex
      - type: nfs
        name: collections
        host: "gladedm1.ucar.edu"
        path: "/gpfs/csfs1/collections"
        destination_path: /glade/collections
      - type: nfs
        name: work
        host: "gladedm1.ucar.edu"
        path: "/gpfs/csfs1/work"
        destination_path: /glade/work
    configmap:
      files:
        - filename: "launch.sh"
          mount_path: "/ood"
          data: |
            #!/bin/sh
            # Deliberately plain /bin/sh -- an image may not ship bash.
            set -u

            CSENV=/ood/csenv
            PORT=8080

            i=0
            while [ "$i" -lt 120 ]; do
              if [ -f "$CSENV" ] && grep -q '^password=' "$CSENV"; then
                break
              fi
              i=$((i + 1))
              sleep 1
            done

            PASSWORD="$(sed -n 's/^password=//p' "$CSENV" 2>/dev/null | head -n 1)"
            if [ -z "$PASSWORD" ]; then
              echo "launch.sh: gave up after ${i}s waiting for the session password." >&2
              echo "  Expected a 'password=' line in $CSENV, written by the" >&2
              echo "  add-passwd-to-cfg init container. Current contents:" >&2
              cat "$CSENV" >&2 2>/dev/null
              exit 1
            fi
            export PASSWORD

            for c in /usr/bin/code-server \
                     /usr/local/bin/code-server \
                     /usr/lib/code-server/bin/code-server \
                     /opt/code-server/bin/code-server \
                     "$HOME/.local/bin/code-server"; do
              if [ -x "$c" ]; then
                CS="$c"
                break
              fi
            done
            [ -n "${CS:-}" ] || CS="$(command -v code-server 2>/dev/null)"

            if [ -z "${CS:-}" ]; then
              echo "launch.sh: no code-server executable in this image." >&2
              echo "  Looked in: /usr/bin, /usr/local/bin, /usr/lib/code-server/bin," >&2
              echo "  /opt/code-server/bin, \$HOME/.local/bin, and \$PATH." >&2
              echo "  PATH=$PATH" >&2
              echo "  This is a packaging problem with the image, not something" >&2
              echo "  you can fix from the launch form -- please report it." >&2
              exit 127
            fi

            WORKDIR="${CODE_SERVER_WORKDIR:-$HOME}"
            if [ ! -d "$WORKDIR" ]; then
              echo "launch.sh: '$WORKDIR' is not a directory in this session;" >&2
              echo "  opening $HOME instead. Only your home directory is mounted." >&2
              WORKDIR="$HOME"
            fi
            cd "$WORKDIR" || cd "$HOME" || exit 1

            DATA_DIR="$HOME/.local/share/code-server"
            if ! mkdir -p "$DATA_DIR/extensions" 2>/dev/null; then
              echo "launch.sh: WARNING cannot create $DATA_DIR" >&2
              echo "  Your home directory is not writable in this session. That usually" >&2
              echo "  means the NFS mount failed or the pod is running as the wrong UID." >&2
              echo "  Falling back to container-local storage: extensions, settings, and" >&2
              echo "  anything you save outside your home will be LOST when this session" >&2
              echo "  ends." >&2
              DATA_DIR="/tmp/code-server"
              mkdir -p "$DATA_DIR/extensions" || exit 1
              # --user-data-dir alone is not enough to get off the unwritable
              # home. code-server resolves its own log directory through XDG
              # ($XDG_DATA_HOME/code-server/coder-logs), independently of that
              # flag, and keeps retrying the mkdir from a background process --
              # so without this the fallback still spews uncaught EACCES.
              export XDG_DATA_HOME="/tmp/code-server/xdg-data"
              export XDG_CONFIG_HOME="/tmp/code-server/xdg-config"
              export XDG_CACHE_HOME="/tmp/code-server/xdg-cache"
              mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" || exit 1
            fi

            echo "launch.sh: code-server=${CS} workdir=${WORKDIR} data=${DATA_DIR}"

            # code-server rewrites this file at most once a minute. Its liveness
            # check is server.getConnections(), so the file keeps advancing as
            # long as a browser holds a socket open and STOPS within ~60s of the
            # last one closing. Staleness therefore measures time DISCONNECTED,
            # not time idle -- a connected-but-unused tab beats forever.
            HEARTBEAT="${XDG_DATA_HOME:-$HOME/.local/share}/code-server/heartbeat"
            DISCONNECT_TIMEOUT=<%= disconnect_timeout %>
            CONNECTED_IDLE_TIMEOUT=<%= connected_idle_timeout %>
            IDLE_CHECK=<%= idle_check_interval %>
            BUSY_CPU_MS=<%= busy_cpu_ms %>
            CULLED=/tmp/code-server-idle-culled
            rm -f "$CULLED"
            STARTED="$(date +%s)"

            # Cumulative CPU for the whole pod, in ms. Read from the cgroup, not
            # by summing /proc/<pid>/stat: /proc only shows processes that are
            # still alive, so a compile that starts and finishes between two
            # samples registers as zero. The cgroup counter includes reaped
            # children, which is the whole point.
            cpu_ms() {
              if [ -r /sys/fs/cgroup/cpu.stat ]; then
                # cgroup v2
                awk '/^usage_usec/ { print int($2 / 1000); found = 1 } END { if (!found) print "" }' \
                  /sys/fs/cgroup/cpu.stat
              elif [ -r /sys/fs/cgroup/cpuacct/cpuacct.usage ]; then
                # cgroup v1, nanoseconds
                awk '{ print int($1 / 1000000) }' /sys/fs/cgroup/cpuacct/cpuacct.usage
              else
                echo ""
              fi
            }

            "$CS" \
              --auth password \
              --bind-addr "0.0.0.0:${PORT}" \
              --user-data-dir "$DATA_DIR" \
              --extensions-dir "$DATA_DIR/extensions" \
              --disable-telemetry \
              --disable-update-check \
              --ignore-last-opened \
              --log "${LOG_LEVEL:-info}" \
              "$WORKDIR" &
            CS_PID=$!

            (
              PREV_CPU="$(cpu_ms)"
              LAST_BUSY="$STARTED"
              if [ -z "$PREV_CPU" ]; then
                echo "launch.sh: no cgroup CPU accounting available; the connected-but-idle cull is disabled for this session (the disconnect cull still applies)." >&2
              fi

              while sleep "$IDLE_CHECK"; do
                kill -0 "$CS_PID" 2>/dev/null || exit 0
                NOW="$(date +%s)"

                # --- did the pod actually do anything this interval? ---
                if [ -n "$PREV_CPU" ]; then
                  CUR_CPU="$(cpu_ms)"
                  if [ -n "$CUR_CPU" ]; then
                    if [ "$((CUR_CPU - PREV_CPU))" -ge "$BUSY_CPU_MS" ]; then
                      LAST_BUSY="$NOW"
                    fi
                    PREV_CPU="$CUR_CPU"
                  fi
                fi

                # --- tier 1: browser disconnected ---
                # Falls back to this session's start time until the heartbeat
                # exists, so a session nobody ever opens is still reclaimed
                # rather than living out its full wall time.
                BEAT="$(stat -c %Y "$HEARTBEAT" 2>/dev/null || echo "$STARTED")"
                DISCONNECTED=$(( NOW - BEAT ))
                if [ "$DISCONNECTED" -ge "$DISCONNECT_TIMEOUT" ]; then
                  echo "launch.sh: no browser connected for ${DISCONNECTED}s (limit ${DISCONNECT_TIMEOUT}s)." >&2
                  REASON="disconnected"
                else
                  REASON=""
                fi

                # --- tier 2: browser connected, but nothing is happening ---
                if [ -z "$REASON" ] && [ -n "$PREV_CPU" ]; then
                  IDLE=$(( NOW - LAST_BUSY ))
                  if [ "$IDLE" -ge "$CONNECTED_IDLE_TIMEOUT" ]; then
                    echo "launch.sh: browser connected but the session used almost no CPU for ${IDLE}s (limit ${CONNECTED_IDLE_TIMEOUT}s)." >&2
                    REASON="idle"
                  fi
                fi

                if [ -n "$REASON" ]; then
                  echo "launch.sh: ending this session so it stops holding its CPU, memory, and GPU." >&2
                  echo "launch.sh: relaunch from OnDemand when you need it; your files, settings, and extensions are in your home directory." >&2
                  : > "$CULLED"
                  kill -TERM "$CS_PID" 2>/dev/null
                  exit 0
                fi
              done
            ) &

            trap 'kill -TERM "$CS_PID" 2>/dev/null; exit 0' TERM INT

            wait "$CS_PID"
            RC=$?

            if [ -f "$CULLED" ]; then
              echo "launch.sh: session ended by the idle timeout (exit 0 so the pod completes rather than restarting)."
              exit 0
            fi
            exit "$RC"

        - filename: "csenv"
          data: |
        - filename: "passwd"
          data: |
            root:x:0:0:root:/root:/bin/bash
            <%= user.name %>:x:<%= user.uid %>:<%= user.group.id %>:<%= gecos %>:<%= user.home %>:/bin/bash
            nobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin
            <%- unless user.uid == 1000 -%>
            coder:x:1000:1000:default container user:/home/coder:/bin/bash
            <%- end -%>
          mount_path: "/etc/passwd"
          sub_path: "passwd"
        - filename: "group"
          data: |
            root:x:0:
            <%= user.group.name %>:x:<%= user.group.id %>:<%= user.name %>
<%-
  # Never let a group lookup break submission; an unnamed GID is a blemish, a
  # failed launch is not.
  seen_gids  = [0, user.group.id]
  seen_names = ["root", user.group.name]
  host_groups = begin
                  File.readlines("/etc/group")
                rescue StandardError
                  []
                end
  host_groups.each do |line|
    name, _passwd, gid, _members = line.chomp.split(":", 4)
    next if name.nil? || gid.nil? || gid !~ /\A\d+\z/
    gid = gid.to_i
    next if gid >= 1000
    next if seen_gids.include?(gid) || seen_names.include?(name)
    seen_gids << gid
    seen_names << name
-%>
            <%= name %>:x:<%= gid %>:
<%- end -%>
            <%- unless seen_gids.include?(1000) || seen_names.include?("coder") -%>
            coder:x:1000:
            <%- end -%>
            <%- unless seen_gids.include?(65534) || seen_names.include?("nogroup") -%>
            nogroup:x:65534:
            <%- end -%>
          mount_path: "/etc/group"
          sub_path: "group"
        <%- unless kube_config_lines.empty? -%>
        - filename: "kubeconfig"
          data: |
<%- kube_config_lines.each do |line| -%>
            <%= line %>
<%- end -%>
          mount_path: "<%= user.home %>/.kube/config"
          sub_path: "kubeconfig"
        <%- end -%>
    init_containers:
      - name: "init-secret"
        image: "<%= utility_img %>"
        command:
          - "/bin/save_passwd_as_secret"
      - name: "add-passwd-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "source /bin/passwd_from_secret; /bin/add_line_to_configmap password=$PASSWORD csenv"
